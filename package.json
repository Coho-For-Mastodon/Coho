{
  "name": "coho",
  "version": "0.0.1",
  "description": "A Mastodon client that prioritizes ease-of-use and clean design.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite --port 3000",
    "preview": "vite preview --port 3000",
    "start": "npm run dev",
    "start-remote": "vite --host",
    "start-functions": "cd functions && npm run serve",
    "build": "npm run localize:build && vite build && npm run ssr:inject",
    "build:no-ssr": "npm run localize:build && vite build",
    "ssr:generate": "npx tsx scripts/ssr-shells.mjs",
    "ssr:inject": "npx tsx scripts/ssr-shells.mjs --inject",
    "bundle:analyze": "ANALYZE_BUNDLE=true npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:e2e:ui": "playwright test --config playwright.e2e.config.ts --ui",
    "test:e2e:headed": "playwright test --config playwright.e2e.config.ts --headed",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "format": "prettier --write \"src/**/*.{ts,js,css,html}\" \"build/**/*.{ts,js}\" \"*.{ts,js,css,html,json}\" \"functions/src/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css,html}\" \"build/**/*.{ts,js}\" \"*.{ts,js,css,html,json}\" \"functions/src/**/*.{ts,js}\"",
    "localize:extract": "lit-localize extract",
    "localize:build": "lit-localize build",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "lint-staged": {
    "*.{js,ts,css,html,json}": [
      "prettier --write"
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@huggingface/transformers": "^4.1.0",
    "@lit/localize": "^0.12.2",
    "fast-blurhash": "^1.2.0",
    "hotkeys-js": "^4.0.4",
    "idb-keyval": "^6.2.5",
    "lit": "^3.3.3",
    "marked": "^18.0.5",
    "web-router": "^0.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@lit-labs/ssr": "^4.1.0",
    "@lit/localize-tools": "^0.8.2",
    "@playwright/test": "^1.61.1",
    "@types/dom-navigation": "^1.0.7",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "^2.14.6",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^6.0.11",
    "terser": "^5.50.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11"
  }
}
