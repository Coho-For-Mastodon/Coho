{
  "name": "pwa-starter",
  "version": "0.0.1",
  "description": "A starter kit for building PWAs!",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev-server": "vite --port 3000",
    "dev": "npm run dev-server",
    "dev-task": "vite",
    "build": "npm run localize:build && tsc && vite build",
    "start": "npm run dev",
    "start-remote": "vite --host",
    "bundle:analyze": "ANALYZE_BUNDLE=true npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.{ts,js}\" \"functions/src/**/*.{ts,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" \"functions/src/**/*.{ts,js}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,css,html}\" \"*.{ts,js,css,html,json}\" \"functions/src/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css,html}\" \"*.{ts,js,css,html,json}\" \"functions/src/**/*.{ts,js}\"",
    "localize:extract": "lit-localize extract",
    "localize:build": "lit-localize build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json}": [
      "prettier --write"
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fluentui/web-components": "^2.5.16",
    "@huggingface/transformers": "^3.8.1",
    "@lit-labs/virtualizer": "^2.0.11",
    "@lit/localize": "^0.12.2",
    "@virtualstate/navigation": "^1.0.1-alpha.212",
    "browser-fs-access": "^0.38.0",
    "fast-blurhash": "^1.1.2",
    "hotkeys-js": "^3.10.1",
    "idb-keyval": "^6.2.0",
    "lit": "^3.3.1",
    "marked": "^17.0.0",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@lit/localize-tools": "^0.8.0",
    "@open-wc/testing": "^4.0.0",
    "@types/dom-navigation": "^1.0.6",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "eslint": "^9.39.1",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-wc": "^3.0.2",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "msw": "^2.7.0",
    "playwright": "^1.57.0",
    "prettier": "^3.7.3",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "vite-plugin-wasm": "^3.2.1",
    "vitest": "^4.0.16"
  }
}
